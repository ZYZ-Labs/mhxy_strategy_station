{
  "name": "mhxy-strategy-station",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A moderated, MCP-ready Fantasy Westward Journey strategy station on Cloudflare Workers.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types && react-router typegen",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && wrangler deploy --dry-run",
    "dev": "react-router dev",
    "preview": "npm run build && vite preview",
    "worker:deploy": "npm run build && wrangler deploy",
    "deploy": "npm run worker:deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply mhxy-strategy-station --remote"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "isbot": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@cloudflare/vitest-pool-workers": "0.19.0",
    "@cloudflare/workers-types": "5.20260728.1",
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.3.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.115.0"
  }
}
